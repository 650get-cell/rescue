# Copy this file to .env and fill in real values before running in production.
# .env is NOT read by the app automatically — your process manager / Docker
# host needs to inject these as actual environment variables.

# HTTP listen port. Default 3000 if unset.
PORT=3000

# REQUIRED. Admin password used by /scheduler.html and /availability_view.html.
# Default in code is 'change-me' which is unsafe — never deploy without setting this.
# Pick a long random string. Get the current production value from James through
# a secure channel if you need to migrate state from the existing Replit instance.
ADMIN_PASSWORD=change-me
