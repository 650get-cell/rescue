# Copy this file to .env and fill in real values before running in production.
# .env is NOT read by the app automatically — your process manager / Docker
# host needs to inject these as actual environment variables.

# REQUIRED. PostgreSQL connection string. Run db/schema.sql against it once first.
# Append ?sslmode=require if your database host requires TLS.
DATABASE_URL=postgres://user:password@host:5432/rescue

# REQUIRED. Admin password for the admin pages (/admin.html and the tools it links to).
# Default in code is 'change-me', which is unsafe — never deploy without setting this.
# Get the current production value from James through a secure channel.
ADMIN_PASSWORD=change-me

# HTTP listen port. Default 3000 if unset.
PORT=3000
